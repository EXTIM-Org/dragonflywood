# ==============================================================
# EXTIM E-Commerce Environment Variables Example
# ==============================================================
# This is an example of the .env file needed for this project.
# Copy this file to .env and replace the values with your own.
# DO NOT commit the actual .env file to version control.
# ==============================================================

# Database Connection (Prisma + PostgreSQL)
DATABASE_URL="postgresql://ecommerce_user:ecommerce_password@localhost:5432/ecommerce_db?schema=public&connection_limit=5&pool_timeout=10"

# Redis (Cache & Background Jobs)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-extim-key-for-development"
JWT_PREVIOUS_SECRET=""

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Notifications (SMTP)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Extim Store <noreply@yourdomain.com>"

# SMS Notifications (OTP)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_LINE_NUMBER=""
SMS_IR_VERIFY_TEMPLATE_ID=""

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"

# Tapin Shipping Service (tapin.ir)
TAPIN_API_TOKEN=""
TAPIN_SHOP_ID=""
TAPIN_API_URL="https://api.tapin.ir"
