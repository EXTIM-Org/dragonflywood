# ==============================================================
# 🚀 EXTIM E-Commerce Environment Variables Example
# ==============================================================
# This is an example of the .env file needed for this project.
# Copy this file to .env and replace the values with your own.
# DO NOT commit the actual .env file to version control.
# ==============================================================

# --------------------------------------------------------------
# 📦 Database Connection (Prisma 8 + PostgreSQL)
# --------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Ensure your PostgreSQL instance is running and credentials match.
DATABASE_URL="postgresql://ecommerce_user:ecommerce_password@localhost:5432/ecommerce_db?schema=public&connection_limit=5&pool_timeout=10"

# --------------------------------------------------------------
# 🔴 Redis (Cache & Background Jobs)
# --------------------------------------------------------------
# Used for BullMQ queues and Rate Limiting
REDIS_URL="redis://localhost:6379"

# --------------------------------------------------------------
# 🔐 Authentication & Security
# --------------------------------------------------------------
# Used by jose (JWT) to sign and encrypt session cookies.
# Generate a strong, random 32-character string for production.
# Example: `openssl rand -base64 32`
JWT_SECRET="super-secret-extim-key-for-development"
JWT_PREVIOUS_SECRET="" # Used for graceful key rotation (old key)

# --------------------------------------------------------------
# 🌐 Application Environment
# --------------------------------------------------------------
# Next.js environment (development, test, or production)
NODE_ENV="development"

# The base URL of the application (useful for absolute links and auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------------
# 📧 Email Notifications (Provider-Agnostic SMTP)
# --------------------------------------------------------------
# We use Nodemailer to send emails, making it independent of any specific provider.
# You can use any SMTP server (e.g. Resend, SendGrid, Gmail, or your own Mail Server).
# If SMTP_HOST is left empty, the application will NOT send real emails, but will 
# instead print them to the terminal console (useful for local development).

SMTP_HOST=""          # e.g., smtp.resend.com or mail.yourdomain.com
SMTP_PORT="465"       # Usually 465 (SSL) or 587 (TLS)
SMTP_USER=""          # e.g., resend API key, or your mail server username
SMTP_PASSWORD=""      # Your SMTP password
SMTP_FROM="Extim Store <noreply@yourdomain.com>" # The 'From' address for emails

# --------------------------------------------------------------
# 📱 SMS Notifications (OTP)
# --------------------------------------------------------------
# We support third-party SMS providers (e.g. Kavenegar, Ghasedak, FarazSMS).
# If SMS_PROVIDER or SMS_API_KEY is left empty, the application will NOT send real SMS,
# but will instead print the OTP codes to the terminal console (useful for local development).

SMS_PROVIDER=""       # e.g., Kavenegar, FarazSMS, etc.
SMS_API_KEY=""        # Your SMS provider API Key
SMS_SENDER=""         # (Optional) The sender line number provided by your SMS provider

# --------------------------------------------------------------
# 🛡️ Sentry Error Tracking
# --------------------------------------------------------------
# Set this to your Sentry DSN to enable error tracking
NEXT_PUBLIC_SENTRY_DSN=""
# Required for uploading Source Maps during `npm run build`
SENTRY_AUTH_TOKEN=""

# --------------------------------------------------------------
# 💳 Zarinpal Payment Gateway
# --------------------------------------------------------------
# Your 36-character Merchant ID from Zarinpal panel
ZARINPAL_MERCHANT_ID=""
# Set to "true" for testing with Zarinpal sandbox, or "false" for production
ZARINPAL_SANDBOX="false"

